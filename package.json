{
  "name": "autonomous-buyer-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "agents/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "build": "npm run build:core && npm run build:web",
    "test": "node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "bench": "node dist/packages/bench/run.js --cases packages/bench/cases",
    "db:migrate": "node scripts/migrate.mjs --database-url \"$DATABASE_URL\"",
    "db:test": "node --test --test-concurrency=1 \"dist/test/db/**/*.test.js\"",
    "test:contract": "node --test \"dist/test/contract/**/*.test.js\"",
    "build:web": "npm run build -w @buyeros/web",
    "build:core": "node node_modules/typescript7/bin/tsc -p tsconfig.json && npm run build -w @buyeros/core",
    "dev": "npm run dev -w @buyeros/web",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "jose": "6.2.17",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "typescript7": "npm:typescript@7.0.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
