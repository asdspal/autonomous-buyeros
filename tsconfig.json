{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "declaration": false
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "agents/**/*.ts",
    "services/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "apps/web",
    "test/e2e"
  ]
}
